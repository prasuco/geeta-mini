---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

type Props = {
  title: string;
  description?: string;
  chapter?: number;
  verse?: number;
  robots?: string;
};

// import "@fontsource-variable/inter";

const {
  description = "Bhagavad Gita |  Complete Chapters with Slok, Meaning & Commentary | Geeta.Prasuco.com",
  title,
  chapter,
  verse,
  robots,
} = Astro.props;

const rawPathname = Astro.url.pathname;
const pathname =
  rawPathname.length > 1 && !rawPathname.endsWith("/")
    ? `${rawPathname}/`
    : rawPathname;
const canonicalURL = new URL(pathname, Astro.site);
const ogImage = chapter && verse
  ? new URL(`/og/${chapter}/${verse}.webp`, Astro.site).href
  : chapter
    ? new URL(`/og/${chapter}.webp`, Astro.site).href
    : new URL(`/og.png`, Astro.site).href;

const schema = chapter && verse ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `Bhagavad Gita Chapter ${chapter}, Verse ${verse}`,
  "description": description,
  "image": ogImage,
  "url": canonicalURL.href,
  "author": {
    "@type": "Person",
    "name": "Krishna"
  },
  "book": {
    "@type": "Book",
    "name": "Bhagavad Gita",
    "author": {
      "@type": "Person",
      "name": "Vyasa"
    }
  }
} : chapter ? {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "headline": `Bhagavad Gita Chapter ${chapter}`,
  "description": description,
  "image": ogImage,
  "url": canonicalURL.href
} : {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Geeta Mini - Bhagavad Gita",
  "description": description,
  "url": canonicalURL.href,
  "potentialAction": {
    "@type": "SearchAction",
    "target": new URL("/?q={search_term_string}", Astro.site).href,
    "query-input": "required name=search_term_string"
  }
};

export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <style>
      * {
        font-family: "Inter Variable", sans-serif;
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EA580C" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Geeta Mini" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>

    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Open Graph -->
    <meta property="og:type" content={chapter && verse ? "article" : chapter ? "website" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {
      process.env.NODE_ENV === "production" && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="e13deb2e-6518-4468-9ac9-dc048737504e"
        />
      )
    }

    <!-- jQuery and jQuery Modal -->
    <script is:inline src="/js/jquery.min.js"></script>
    <script is:inline src="/js/jquery.modal.js"></script>
    <link rel="stylesheet" href="/css/jquery.modal.css" />

    <!-- Ads: site-level loaders -->


     {
      process.env.NODE_ENV === "production" && (
      
        <script is:inline src="https://pl30713632.effectivecpmnetwork.com/72/12/f6/7212f6253c66ba5025f3039b96db0e17.js"></script>
        <script is:inline src="https://pl30713635.effectivecpmnetwork.com/42/ed/cc/42edcc3dad303ac9ab7eaab7bdeda04c.js"></script>
      )
    }

    <ClientRouter />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </head>
  <body data-umami-auto-track data-umami-auto-track-all-clicks="true">
    <slot />

    <!-- In-content ad unit -->
    <div id="container-2c7f01448830b9b735e860eae53f833a"></div>


     {
      process.env.NODE_ENV === "production" && (
      
        <script async="async" data-cfasync="false" is:inline src="https://pl30713633.effectivecpmnetwork.com/2c7f01448830b9b735e860eae53f833a/invoke.js"></script>

      )
    }
  </body>
</html>
