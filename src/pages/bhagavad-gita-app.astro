---
import BaseHead from "../base/BaseHead.astro";
import MobileLayout from "../base/layouts/MobileLayout.astro";
import MailCTA from "../components/MailCTA.astro";
export const prerender = true;
---

<BaseHead
  title="Best Bhagavad Gita App & Online Reader (Sanskrit + English) | Geeta.Prasuco.com"
  description="Read the Bhagavad Gita online for free — a complete reader with original Sanskrit, transliteration, English and Nepali translations, word meanings, commentaries, audio recitation, and bookmarks. No sign-up required."
>
  <MobileLayout>
    <article class="max-w-3xl mx-auto px-4 py-8 space-y-8">
      <header class="space-y-3">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 font-serif">
          A Complete Bhagavad Gita Reader — Sanskrit &amp; English
        </h1>
        <p class="text-lg text-gray-500 leading-relaxed">
          Everything you'd expect from the best Bhagavad Gita app, right in your
          browser — free, fast, and with no sign-up. All 18 chapters, 700
          verses, original Sanskrit, and multiple English translations.
        </p>
      </header>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-gray-900 font-serif">
          Why readers choose Geeta Mini
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Original Sanskrit with every verse</strong>
              <p class="text-sm text-gray-500 mt-0.5">Devanagari text plus Roman transliteration, so you can read and pronounce each verse correctly.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Multiple English translations</strong>
              <p class="text-sm text-gray-500 mt-0.5">Compare translations from renowned scholars side by side to get the full meaning of each teaching.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Word-by-word meanings</strong>
              <p class="text-sm text-gray-500 mt-0.5">Every Sanskrit word broken down with its meaning, perfect for students and first-time readers.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Commentaries that explain context</strong>
              <p class="text-sm text-gray-500 mt-0.5">Understand why Krishna said what he said, and how it applies to modern life.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Nepali translations available</strong>
              <p class="text-sm text-gray-500 mt-0.5">Read the Gita in Nepali — a differentiator few other apps offer.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Audio recitation</strong>
              <p class="text-sm text-gray-500 mt-0.5">Listen to authentic Sanskrit recitation of every verse.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Bookmarks &amp; search</strong>
              <p class="text-sm text-gray-500 mt-0.5">Save your favourite verses and jump straight to any verse by number or keyword.</p>
            </div>
          </li>
          <li class="flex items-start gap-3 p-4 bg-orange-50/40 rounded-2xl">
            <span class="text-orange-600 font-bold mt-0.5">✓</span>
            <div>
              <strong>Free, forever, no ads</strong>
              <p class="text-sm text-gray-500 mt-0.5">No downloads, no sign-up, no paywall — the complete text is free to read online.</p>
            </div>
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-gray-900 font-serif">
          A daily reading habit
        </h2>
        <p class="text-gray-500 leading-relaxed">
          Many readers use Geeta Mini as a verse-a-day companion. Prefer email?
          <a href="/geeta-mail" class="text-orange-600 hover:underline">Geeta in Mail</a>{" "}
          sends one short, practical teaching from the Gita to your inbox every
          morning — a simple way to stay consistent.
        </p>
        <p class="text-gray-500 leading-relaxed">
          Start with the famous verse{" "}
          <a href="/2/47" class="text-orange-600 hover:underline">Bhagavad Gita 2.47</a>{" "}
          on doing your duty without attachment to results, or explore the full
          collection below.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-gray-900 font-serif">
          All 18 chapters
        </h2>
        <p class="text-gray-500 leading-relaxed">
          Every chapter with every verse:{" "}
          <a href="/1" class="text-orange-600 hover:underline">Chapter 1</a>,{" "}
          <a href="/2" class="text-orange-600 hover:underline">Chapter 2</a>,{" "}
          <a href="/3" class="text-orange-600 hover:underline">Chapter 3</a>,{" "}
          <a href="/4" class="text-orange-600 hover:underline">Chapter 4</a>,{" "}
          <a href="/5" class="text-orange-600 hover:underline">Chapter 5</a>,{" "}
          <a href="/6" class="text-orange-600 hover:underline">Chapter 6</a>,{" "}
          <a href="/7" class="text-orange-600 hover:underline">Chapter 7</a>,{" "}
          <a href="/8" class="text-orange-600 hover:underline">Chapter 8</a>,{" "}
          <a href="/9" class="text-orange-600 hover:underline">Chapter 9</a>,{" "}
          <a href="/10" class="text-orange-600 hover:underline">Chapter 10</a>,{" "}
          <a href="/11" class="text-orange-600 hover:underline">Chapter 11</a>,{" "}
          <a href="/12" class="text-orange-600 hover:underline">Chapter 12</a>,{" "}
          <a href="/13" class="text-orange-600 hover:underline">Chapter 13</a>,{" "}
          <a href="/14" class="text-orange-600 hover:underline">Chapter 14</a>,{" "}
          <a href="/15" class="text-orange-600 hover:underline">Chapter 15</a>,{" "}
          <a href="/16" class="text-orange-600 hover:underline">Chapter 16</a>,{" "}
          <a href="/17" class="text-orange-600 hover:underline">Chapter 17</a>,{" "}
          <a href="/18" class="text-orange-600 hover:underline">Chapter 18</a>.
        </p>
      </section>

      <div class="pt-4">
        <MailCTA />
      </div>
    </article>
  </MobileLayout>
</BaseHead>
